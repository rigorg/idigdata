# Website-own Supabase (reserved / light use — not the DigOps beacon sink)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

WEBSITE_ALLOWED_ORIGINS=
NEXT_PUBLIC_WEBSITE_EVENT_INGEST_URL=
NEXT_PUBLIC_TRACK_PREVIEW_TRAFFIC=
# Default captures entrance/door-knock only. Set to 1 for pageviews + dwell/scroll.
NEXT_PUBLIC_TRACK_PAGE_NAVIGATION=

# DigOps (operations) Supabase bridge — prefer anon for inserts (RLS insert-only).
DIGOPS_SUPABASE_URL=
DIGOPS_SUPABASE_ANON_KEY=
# Optional. Only needed if /api/contact should return inserted CRM row IDs.
DIGOPS_SUPABASE_SERVICE_ROLE_KEY=
# Required in production for door-knock IP fingerprints. HMAC key. No public default.
DIGOPS_IP_HASH_SALT=

# Beacon identity
# ?internal=1 stamps Operator cookie. Fleet requires header in production:
#   x-digops-traffic: fleet:<DIGOPS_FLEET_BEACON_SECRET>
DIGOPS_INTERNAL_IPS=
DIGOPS_FLEET_BEACON_SECRET=

RESEND_API_KEY=
EMAIL_NOTIFY_TO=
EMAIL_NOTIFY_FROM=
